# Django Configuration
DJANGO_SECRET_KEY=generate-a-secure-secret-key-for-production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=*

# Security & Management Dashboard Access Control
# When True, visiting /manage/ or /manage/api/ requires staff authentication or MANAGE_SECRET_TOKEN
MANAGE_REQUIRE_AUTH=True
MANAGE_SECRET_TOKEN=optional-secret-token-for-curl-and-webhooks

# Automated Admin / Superuser Creation on Startup
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=change-to-a-strong-password-123!
DJANGO_SUPERUSER_EMAIL=admin@cineverse.local

# Database Configuration
# Leave DATABASE_URL blank to use local SQLite (default: ./db.sqlite3, or override via SQLITE_DB_PATH).
# For Render / cloud hosting, use a PostgreSQL URL (e.g. Supabase Session Pooler on port 5432):
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DB_CONN_MAX_AGE=60
DB_CONNECT_TIMEOUT=10
CATALOG_STATS_CACHE_SECONDS=60

# Metadata APIs (Get a free TMDB API key at https://www.themoviedb.org/settings/api)
TMDB_API_KEY=your_tmdb_api_key_here
# Optional fallback API key for OMDb IMDb lookup
OMDB_API_KEY=

# H5AI Media Directory (Optional default source URL)
H5AI_BASE_URL=http://your-local-media-server/movies/
