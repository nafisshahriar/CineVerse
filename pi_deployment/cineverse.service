[Unit]
Description=CineVerse Django Web Server
After=network-online.target
Wants=network-online.target

[Service]
# Replace 'pi' and '/home/pi/CineVerse' with your Linux username and clone path
User=pi
Group=pi
WorkingDirectory=/home/pi/CineVerse
EnvironmentFile=-/home/pi/CineVerse/.env
ExecStart=/bin/bash /home/pi/CineVerse/pi_deployment/cineverse_startup.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
